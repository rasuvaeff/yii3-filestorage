{
    "name": "rasuvaeff/yii3-filestorage",
    "description": "DI-native file storage for Yii3: one facade over swappable physical and metadata backends, PSR-7 streaming, safe delivery",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "file-storage",
        "filesystem",
        "psr-7",
        "upload",
        "yii3"
    ],
    "authors": [
        {
            "name": "Victor Razuvaev",
            "email": "rasuvaeff@gmail.com"
        }
    ],
    "homepage": "https://github.com/rasuvaeff/yii3-filestorage",
    "support": {
        "issues": "https://github.com/rasuvaeff/yii3-filestorage/issues",
        "source": "https://github.com/rasuvaeff/yii3-filestorage"
    },
    "require": {
        "php": "8.3 - 8.5",
        "ext-fileinfo": "*",
        "psr/clock": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/mime": "^6.4 || ^7.0 || ^8.0",
        "yiisoft/files": "^2.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.51",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.33",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8",
        "ramsey/uuid": "^4.7",
        "rasuvaeff/property-testing-testo": "^0.4",
        "rasuvaeff/rector-named-literals": "^1.0",
        "rasuvaeff/understudy": "^0.9",
        "rasuvaeff/understudy-testo": "^0.3",
        "rector/rector": "^2.4",
        "roave/backward-compatibility-check": "^8.0",
        "symfony/uid": "^6.4 || ^7.0 || ^8.0",
        "testo/bridge-infection": "^0.1.6",
        "testo/testo": "^0.10.25",
        "vimeo/psalm": "^6.16",
        "yiisoft/di": "^1.4",
        "yiisoft/test-support": "^3.1"
    },
    "suggest": {
        "ramsey/uuid": "Bind RamseyUuidIdGenerator to mint file ids with ramsey/uuid instead of the built-in generator",
        "rasuvaeff/yii3-filestorage-db": "Persist file metadata in a database and enable coordinated deduplication",
        "rasuvaeff/yii3-filestorage-flysystem": "Store objects in S3, GCS or any other Flysystem adapter",
        "rasuvaeff/yii3-filestorage-web": "Serve private files over signed application URLs with Range and conditional GET",
        "symfony/uid": "Bind SymfonyUidIdGenerator to mint file ids with symfony/uid instead of the built-in generator"
    },
    "autoload": {
        "psr-4": {
            "Rasuvaeff\\Yii3Filestorage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rasuvaeff\\Yii3Filestorage\\Benchmarks\\": "benchmarks/",
            "Rasuvaeff\\Yii3Filestorage\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "platform": {
            "ext-bcmath": "1.0.0",
            "ext-intl": "1.0.0"
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        },
        "config-plugin": {
            "di": "di.php",
            "params": "params.php"
        },
        "config-plugin-options": {
            "source-directory": "config"
        },
        "skills": {
            "source": "resources/skills"
        }
    },
    "scripts": {
        "bc-check": "roave-backward-compatibility-check",
        "bench": "testo --suite=Benchmarks -vv",
        "build": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@require-checker",
            "@cs",
            "@psalm",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.php",
        "cs:fix": "php-cs-fixer fix --diff --config=.php-cs-fixer.php",
        "mutation": "infection --threads=max",
        "psalm": "psalm --no-cache",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "release-check": [
            "@build",
            "@rector",
            "sh -c 'LATEST=$(git describe --tags --abbrev=0 2>/dev/null || true); if [ -n \"$LATEST\" ]; then composer bc-check -- --from=\"$LATEST\"; else echo \"No previous tag - skipping BC check\"; fi'"
        ],
        "require-checker": "composer-require-checker check composer.json",
        "test": "testo --suite=Unit",
        "test:coverage": "testo --suite=Unit --coverage --coverage-clover=build/coverage.xml",
        "test:coverage:ci": "testo --suite=Unit --coverage-clover=build/coverage.xml"
    }
}
